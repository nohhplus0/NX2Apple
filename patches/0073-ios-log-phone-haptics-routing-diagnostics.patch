From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nohhplus0 <nohhplus0@users.noreply.github.com>
Date: Thu, 5 Nov 2026 20:30:00 +0900
Subject: [PATCH] ios: log phone haptics routing diagnostics

Upstream-Status: pending
Reason: Add temporary diagnostics to identify whether phone haptics are supported, routed, requested, and successfully started.

Issue: local (GitHub Issues are disabled for this repository)

---
 dm/host/haptics_apple.m | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/dm/host/haptics_apple.m b/dm/host/haptics_apple.m
index 0000000..0000000 100644
--- a/dm/host/haptics_apple.m
+++ b/dm/host/haptics_apple.m
@@ -39,7 +39,10 @@
 static dispatch_queue_t queue;
 static NSMutableArray<DmRumbleChannel *> *channels[DM_PLAYERS];
 static GCController *controllers[DM_PLAYERS];
 static int rumble_output = -1;   // player one: -1 automatic, 0 controller only, 1 phone only
+static BOOL didLogApply;
+static BOOL didLogPhoneRequest;
+static BOOL didLogPhoneOutput;
 #if TARGET_OS_IPHONE
 static BOOL phoneSupported;
 #endif
@@ -141,2 +144,3 @@ - (BOOL)startEngine {
     if (![self.engine startAndReturnError:&error]) { [self engineFailed:error stage:"start engine"]; return NO; }
+    fprintf(stderr, "[RED] haptics: %s engine started\n", self.target.UTF8String);
     return YES;
@@ -163,2 +167,6 @@ - (void)apply:(dm_haptic_level)level {
     self.level = level;
+    if ([self.target isEqualToString:@"phone"] && !didLogPhoneRequest) {
+        didLogPhoneRequest = YES;
+        fprintf(stderr, "[RED] haptics: phone apply request intensity=%.3f\n", level.intensity);
+    }
     if (!self.pattern) {
@@ -213,4 +220,8 @@ - (void)apply:(dm_haptic_level)level {
     if (![self.pattern sendParameters:parameters atTime:CHHapticTimeImmediate error:&error]) {
         [self failed:error stage:"send parameters"]; return;
     }
+    if ([self.target isEqualToString:@"phone"] && !didLogPhoneOutput) {
+        didLogPhoneOutput = YES;
+        fprintf(stderr, "[RED] haptics: phone send parameters succeeded intensity=%.3f\n", level.intensity);
+    }
     self.failures = 0;
@@ -305,2 +316,6 @@ static void apply(dm_haptic_state s) {
         if (s.epoch != dm_haptics_epoch(s.player)) return;
+        if (!didLogApply) {
+            didLogApply = YES;
+            fprintf(stderr, "[RED] haptics: first apply player=%d channels=%lu\n", s.player + 1, (unsigned long)channels[s.player].count);
+        }
         NSArray<DmRumbleChannel *> *out = channels[s.player];
@@ -328,2 +343,3 @@ static void configure(int p, GCController *controller) {
     for (DmRumbleChannel *c in channels[p]) [c stop];
     channels[p] = [NSMutableArray new];
+    fprintf(stderr, "[RED] haptics: configure player=%d controller=%s rumble_output=%d\n", p + 1, controller ? "connected" : "none", rumble_output);
@@ -369,4 +385,5 @@ static void configure(int p, GCController *controller) {
     else if (!p && phoneSupported && (rumble_output == 1 || (!controller && rumble_output == -1))) {
         // Do not initialize the phone's engine before the game's audio session is active.
         add_engine(p, -1, @"phone", ^CHHapticEngine *(NSError **e) { return [[CHHapticEngine alloc] initWithAudioSession:AVAudioSession.sharedInstance error:e]; });
+        fprintf(stderr, "[RED] haptics: phone channel registered\n");
     }
@@ -374,1 +391,2 @@ static void configure(int p, GCController *controller) {
     dm_haptics_route(p, channels[p].count != 0);
+    fprintf(stderr, "[RED] haptics: route player=%d enabled=%d channels=%lu\n", p + 1, channels[p].count != 0, (unsigned long)channels[p].count);
@@ -412,3 +430,4 @@ void dm_haptics_apple_init(void) {
         phoneSupported = CHHapticEngine.capabilitiesForHardware.supportsHaptics;
+        fprintf(stderr, "[RED] haptics: phoneSupported=%d rumble_output=%d\n", phoneSupported, rumble_output);
 #endif
         dispatch_sync(queue, ^{ configure(0, nil); });
