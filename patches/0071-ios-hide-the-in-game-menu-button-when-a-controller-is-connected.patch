From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nohhplus0 <nohhplus0@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:00:00 +0900
Subject: [PATCH] ios: hide the in-game menu button with a physical controller

Upstream-Status: fork-only
Reason: Keep the iOS game view free of touch UI while a physical controller is connected, including the gear menu button.

---
 dm/ios/Sources/DmGamepad.m | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dm/ios/Sources/DmGamepad.m b/dm/ios/Sources/DmGamepad.m
index 9981005..0000000 100644
--- a/dm/ios/Sources/DmGamepad.m
+++ b/dm/ios/Sources/DmGamepad.m
@@ -646,7 +646,7 @@ - (void)padsChanged:(NSNotification *)note {
     GCController *c = note.object, *gone = [note.name isEqual:GCControllerDidDisconnectNotification] ? c : nil;
     if (c && (!c.extendedGamepad || g_merge)) LOG("controller %s: %s%s", gone ? "disconnected" : "connected", pad_name(c), c.extendedGamepad ? "" : " (no extended gamepad profile: not used)");
     BOOL any = g_merge ? pads_merged(gone) : pads_slotted(gone);
-    dispatch_async(dispatch_get_main_queue(), ^{ self->_padOff = any; self->_controls.hidden = any; [self reset]; front_ios_quit_controllers(); });   // the touch gamepad hides while any controller is in use
+    dispatch_async(dispatch_get_main_queue(), ^{ self->_padOff = any; self->_controls.hidden = any; self->_menu.hidden = any; [self reset]; front_ios_quit_controllers(); });   // the touch gamepad and menu button hide while any controller is in use
 }
 @end
